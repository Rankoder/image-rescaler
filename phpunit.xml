<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="random"
         stopOnFailure="false"
         stopOnError="false"
         stopOnIncomplete="false"
         stopOnSkipped="false">
    <testsuites>
        <testsuite name="Unit Tests">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Functional Tests">
            <directory>tests/Functional</directory>
        </testsuite>
        <testsuite name="Integration Tests">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Contract Tests">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>

    <!-- The whole environment the tests see; force="true" overrides the container's .env, so no test sets variables itself -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_HOST" value="localhost" force="true"/>
        <env name="APP_PORT" value="8080" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="test-access-key-id" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="test-secret-access-key" force="true"/>
        <env name="AWS_REGION" value="eu-central-1" force="true"/>
        <env name="AWS_BUCKET_NAME" value="test-bucket" force="true"/>
        <env name="DROPBOX_ACCESS_TOKEN" value="test-dropbox-token" force="true"/>
        <env name="ALLOWED_IMAGE_TYPES" value="image/jpeg,image/jpg,image/png,image/webp" force="true"/>
        <env name="MAX_FILE_SIZE" value="5242880" force="true"/>
    </php>
</phpunit>
