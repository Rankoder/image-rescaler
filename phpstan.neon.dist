includes:
    - phpstan-baseline.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max
    paths:
        - config
        - public
        - src
        - tests
        - routes.php
    phpat:
        show_rule_names: true

services:
    # Architecture rules, see tests/Architecture
    -
        class: Tests\Architecture\LayerDependencyTest
        tags:
            - phpat.test
