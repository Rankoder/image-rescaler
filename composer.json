{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite 'Unit Tests'",
        "test:functional": "phpunit --testsuite 'Functional Tests'",
        "phpstan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer check",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@phpstan", "@test"]
    },
    "scripts-descriptions": {
        "test": "Run all tests",
        "test:unit": "Run unit tests",
        "test:functional": "Run functional tests",
        "phpstan": "Run static analysis",
        "cs": "Check code style without changing files",
        "cs:fix": "Fix code style",
        "check": "Code style, static analysis and tests, as before a PR"
    },
    "require": {
        "aws/aws-sdk-php": "^3.314",
        "kunalvarma05/dropbox-php-sdk": "^0.4.2",
        "intervention/image": "^3.7",
        "vlucas/phpdotenv": "^5.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.0",
      "ext-gd": "*",
        "bramus/router": "^1.6",
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
