{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "build":  "docker-compose up --build -d",
        "ir-up":  "docker-compose up -d",
        "install":  "docker-compose exec web composer install",
        "create-storage":  "mkdir storage",
        "run-tests-all":  "docker-compose exec web vendor/bin/phpunit tests/"
    },
    "require": {
        "aws/aws-sdk-php": "^3.314",
        "kunalvarma05/dropbox-php-sdk": "^0.4.2",
        "intervention/image": "^3.7",
        "vlucas/phpdotenv": "^5.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.0",
        "symfony/process": "^7.1",
      "ext-gd": "*",
        "bramus/router": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "mockery/mockery": "^1.6",
        "mikey179/vfsstream": "^1.6"
    }
}
