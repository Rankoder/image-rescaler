# Application
# Host port of the development container; every copy of the project running on the same machine needs its own
APP_PORT=8080
# Compose project name; two copies in directories with the same name would share containers, so give each copy its own
COMPOSE_PROJECT_NAME=image-rescaler
# Input directory inside the container (API and CLI); storage/input when empty
INPUT_DIR=

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=your_aws_bucket_name

# Dropbox Configuration
# Required only when using dropbox storage; scopes: files.content.write, files.metadata.read, sharing.write
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token
# Dropbox folder the images go to; must start with "/"
DROPBOX_DIRECTORY=/Aplikacje/image-rescaler
