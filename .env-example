# Application
# Host port of the development container; a second copy of the project next to this one needs another, e.g. 8081
APP_PORT=8080
# Directory inside the container the CLI reads images from; storage/input when empty
INPUT_DIR=

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=your_aws_bucket_name

# Dropbox Configuration
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token
# Dropbox folder the images go to
DROPBOX_DIRECTORY=/Aplikacje/image-rescaler
