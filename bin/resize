#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Infrastructure\Config\AppConfig;
use App\Infrastructure\Container;

require __DIR__ . '/../vendor/autoload.php';

$container = new Container(AppConfig::fromEnvironment(getenv(), dirname(__DIR__)));

exit($container->resizeCommand()->run(getopt('f:w:h:s:o:') ?: [], STDOUT, STDERR));
